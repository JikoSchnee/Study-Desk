# Vercel server-only secrets. Never expose the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Stable production origin and OAuth handoff encryption (server only).
STUDY_DESK_PUBLIC_URL=https://study-desk.jiko-official.top
STUDY_DESK_AUTH_HANDOFF_KEY=replace-with-another-32-byte-base64-key

# Public API origin embedded into desktop builds. This is a URL, not a secret.
NEXT_PUBLIC_STUDY_DESK_SERVICE_URL=https://study-desk.jiko-official.top

# Desktop release encryption. Generate with: openssl rand -base64 32
STUDY_DESK_TRANSFER_KEY_VERSION=1
STUDY_DESK_TRANSFER_KEY_CURRENT=replace-with-32-byte-base64-key
STUDY_DESK_TRANSFER_KEY_PREVIOUS={}

# Paddle Sandbox first; switch PADDLE_ENV only after account/KYC approval.
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_replace-me
PADDLE_CLIENT_TOKEN=test_replace-me
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace-me
PADDLE_MONTHLY_PRICE_ID=pri_replace-monthly
PADDLE_YEARLY_PRICE_ID=pri_replace-yearly
CRON_SECRET=replace-with-random-cron-secret

# Any OpenAI-compatible chat-completions endpoint. Leave unset to use the local fallback evaluator.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
