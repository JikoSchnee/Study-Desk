{
  "name": "mock-interview",
  "version": "1.4.2",
  "description": "本地优先的面试知识训练桌面应用",
  "author": "JikoSchnee",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "desktop:prepare": "node desktop/prepare-next.cjs",
    "desktop:rebuild": "node desktop/rebuild-native.cjs",
    "desktop:sync-native": "node desktop/sync-native.cjs",
    "desktop:build": "npm run build && npm run desktop:prepare && npm run desktop:rebuild && npm run desktop:sync-native && npm rebuild better-sqlite3",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:dist": "npm run desktop:build && electron-builder --publish never",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "better-sqlite3": "^12.4.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.7",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "ts-fsrs": "^5.2.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.31.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "playwright": "^1.55.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.jikoschnee.mockinterview",
    "productName": "八股训练台",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "next"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "next/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": ".next/static",
        "to": "next/.next/static"
      },
      {
        "from": "public",
        "to": "next/public"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "八股训练台 ${version}"
    },
    "afterSign": "desktop/notarize.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "JikoSchnee",
        "repo": "Study-Desk",
        "releaseType": "release"
      }
    ]
  }
}
