{
  "name": "study-desk",
  "version": "1.7.1",
  "description": "像背单词一样整理自己的知识卡片库",
  "author": "JikoSchnee",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "desktop:prepare": "node desktop/prepare-next.cjs",
    "desktop:rebuild": "node desktop/rebuild-native.cjs",
    "desktop:sync-native": "node desktop/sync-native.cjs",
    "desktop:verify-native": "node desktop/verify-native.cjs",
    "desktop:smoke": "node desktop/smoke-next.cjs",
    "desktop:bundle": "node desktop/bundle.cjs",
    "desktop:build": "npm run build && npm run desktop:prepare && npm run desktop:rebuild && npm run desktop:sync-native && npm rebuild better-sqlite3 && npm run desktop:verify-native && npm run desktop:smoke && npm run desktop:bundle",
    "desktop:dev": "npm run desktop:dev:fast",
    "desktop:dev:fast": "node desktop/bundle.cjs && node desktop/dev-fast.cjs",
    "desktop:dev:build": "npm run desktop:build && electron .",
    "desktop:dist": "npm run desktop:build && electron-builder --publish never",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:webdav-setup": "bash scripts/test-setup-webdav.sh",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "mcp:dev": "NODE_OPTIONS=--conditions=react-server tsx src/mcp/index.ts",
    "mcp:inspect": "npx @modelcontextprotocol/inspector npm run mcp:dev"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.112.2",
    "better-sqlite3": "^12.4.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.7",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "ts-fsrs": "^5.2.3",
    "xlsx": "^0.18.5",
    "yauzl": "^3.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/yauzl": "^2.10.3",
    "drizzle-kit": "^0.31.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "playwright": "^1.55.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "main": "desktop/dist/main.cjs",
  "build": {
    "appId": "com.jikoschnee.mockinterview",
    "productName": "Study Desk",
    "artifactName": "Study-Desk-${version}-${os}-${arch}.${ext}",
    "protocols": [
      {
        "name": "Study Desk",
        "schemes": [
          "study-desk"
        ]
      }
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/dist/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "next",
        "filter": [
          "**/*",
          "!node_modules{,/**/*}"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "next/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "next/.next/static"
      },
      {
        "from": "public",
        "to": "next/public"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Study-Desk-Setup-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "Study-Desk-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Study Desk ${version}"
    },
    "afterPack": "desktop/after-pack.cjs",
    "publish": null
  }
}
